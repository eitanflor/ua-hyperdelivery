# Every variable below maps to a field on `Settings` (src/config/settings.py).
# tests/unit/test_docs_consistency.py fails the build if the two drift apart.

# local | dev | prod - see core.constants.Environment. local always uses LocalAgentClient
# (agents' own make dev-* HTTP servers); dev/prod always require STATE_MACHINE_ARN below
# and use the real Step Functions path.
ENVIRONMENT=local
LOG_LEVEL=INFO

# Bedrock / AgentCore Runtime region, and the local port `make dev-*` serves on.
AWS_REGION=us-east-1
# PORT=8080

# Optional: only needed for Distill's Confluence MCP tools (e.g. `confluence_get_page`)
# ATLASSIAN_BASE_URL=https://yourorg.atlassian.net
# ATLASSIAN_EMAIL=you@yourorg.com
# ATLASSIAN_API_TOKEN=

# Optional: only needed for Distill's S3 document-fetch tool (`s3_get_document_text`)
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# Optional: caps the in-memory size of a browser upload to POST /projects/{id}/documents
# MAX_UPLOAD_BYTES=25000000

# Optional: only needed for Distill's Snowflake data tool (`snowflake_query`), which
# delegates discovery and fetching to Snowflake's own Cortex Coding Agent - no warehouse
# or role to configure, the agent resolves those from the PAT's own user context.
# SNOWFLAKE_ACCOUNT=your-account
# SNOWFLAKE_PAT=
# Optional scoping hints, not required - unset, the agent explores the whole account.
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=

# Optional: only needed for Blueprint's/Review's GitHub tools (create_repository/
# issue_write/assign_copilot_to_issue). Reaches GitHub's official remote MCP server over
# HTTPS - no local process to run. Prefer a fine-grained PAT scoped to only the repos/
# orgs you need for a personal account or a non-SSO org. If the target org enforces SAML
# SSO (e.g. underarmour), use a classic PAT with `repo` scope instead, SSO-authorized for
# that org (Settings > Developer settings > Personal access tokens (classic) > token >
# Configure SSO) - fine-grained PATs have no equivalent post-creation SSO step and will
# fail with "blocked by SAML single sign-on" even with every permission granted. See
# docs/decisions.md, "GitHub PAT for SSO-enforced orgs".
# GITHUB_PAT=

# Phase 2 orchestration. Table name is env-suffixed (see infra/stacks/storage_stack.py) -
# defaults to the dev environment's table. Same region as AWS_REGION above; all
# hyperdelivery resources live in us-east-1 (see docs/decisions.md).
# PROJECTS_TABLE=hyperdelivery-dev-projects
# WebSocket connection/ticket table. Deployed by OrchestrationStack; leave unset locally.
# CONNECTIONS_TABLE=
# Leave unset until the state machine is deployed: the console API then falls back to
# DynamoDB-only writes, with no execution to start or resume.
# STATE_MACHINE_ARN=

# Comma-separated origins allowed to call the console API - defaults to the Vite dev
# server (ui/console), only needed if you're serving the console UI from elsewhere.
# CORS_ORIGINS=http://localhost:5173

# Only needed for `make deploy AGENT=<agent>` (scripts/deploy_agent.sh) - the IAM role
# AgentCore Runtime assumes to run the container (see README "Deploying to AgentCore
# Runtime").
# AGENTCORE_ROLE_ARN=arn:aws:iam::<account-id>:role/<role-name>

# Entra ID (Azure AD) - must match the console UI's VITE_ENTRA_TENANT_ID/
# VITE_ENTRA_CLIENT_ID (same app registration); required to validate the bearer ID
# token on /projects/* routes (see src/api/auth.py).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Optional: a local demo convenience only, not a hosted preview. Path to the target
# repo's checkout on this same machine - set it and approving/merging a build also pulls
# its default branch and runs the target repo's own preview script, so a human never
# has to. See infrastructure/local_preview.py, docs/decisions.md.
# PREVIEW_CHECKOUT_PATH=/path/to/checkout
# PREVIEW_COMMAND=./scripts/preview.sh
# PREVIEW_BACKEND_PORT=8000
# PREVIEW_FRONTEND_PORT=5183

# Used by scripts/ensure_aws_login.sh for SSO, not read by Settings.
# AWS_PROFILE=
