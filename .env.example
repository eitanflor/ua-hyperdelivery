# Every variable below maps to a field on `Settings` (src/config/settings.py).
# tests/unit/test_docs_consistency.py fails the build if the two drift apart.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Bedrock / AgentCore Runtime region, and the local port `make dev-*` serves on.
AWS_REGION=us-east-1
# PORT=8080

# Optional: only needed for Distill's Confluence MCP tools (e.g. `confluence_get_page`)
# ATLASSIAN_BASE_URL=https://yourorg.atlassian.net
# ATLASSIAN_EMAIL=you@yourorg.com
# ATLASSIAN_API_TOKEN=

# Optional: only needed for Distill's S3 document-fetch tool (`s3_get_document_text`)
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1

# Phase 2 orchestration. These resources live in ap-southeast-2, deliberately separate
# from AWS_REGION above (Bedrock/AgentCore Runtime, us-east-1) - see docs/decisions.md.
# PROJECTS_TABLE=hyperdelivery-projects
# ORCHESTRATION_REGION=ap-southeast-2
# Leave unset until the state machine is deployed: the console API then falls back to
# DynamoDB-only writes, with no execution to start or resume.
# STATE_MACHINE_ARN=

# Only needed for `make deploy AGENT=<agent>` (scripts/deploy_agent.sh) - the IAM role
# AgentCore Runtime assumes to run the container (see README "Deploying to AgentCore
# Runtime").
# AGENTCORE_ROLE_ARN=arn:aws:iam::<account-id>:role/<role-name>

# Used by scripts/ensure_aws_login.sh for SSO, not read by Settings.
# AWS_PROFILE=
