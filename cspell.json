{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "useGitignore": true,
  "ignorePaths": [
    ".git/**",
    "*.lock",
    "cdk.out/**",
    "coverage.xml",
    "cspell.json",
    "htmlcov/**",
    "node_modules/**"
  ],
  "flagWords": [
    "analyse->analyze",
    "behaviour->behavior",
    "cancelled->canceled",
    "catalogue->catalog",
    "centralise->centralize",
    "centralised->centralized",
    "colour->color",
    "defence->defense",
    "favour->favor",
    "initialise->initialize",
    "judgement->judgment",
    "labelled->labeled",
    "licence->license",
    "minimise->minimize",
    "modelling->modeling",
    "neighbouring->neighboring",
    "normalise->normalize",
    "optimise->optimize",
    "organise->organize",
    "parameterisation->parameterization",
    "parameterise->parameterize",
    "prioritise->prioritize",
    "recognise->recognize",
    "serialise->serialize",
    "summarise->summarize",
    "synthesise->synthesize",
    "travelling->traveling"
  ],
  "words": [
    "addopts",
    "ADVA",
    "agentcore",
    "agentic",
    "apigatewayv",
    "apigwv",
    "ASGI",
    "asyncio",
    "autouse",
    "awscrt",
    "boto",
    "browsable",
    "buildx",
    "charliermarsh",
    "conftest",
    "datetimez",
    "docstrings",
    "edma",
    "errmsg",
    "excinfo",
    "fastapi",
    "filterwarnings",
    "frontmatter",
    "FURB",
    "gitleaks",
    "htmlcov",
    "httpx",
    "Hyperdelivery",
    "idempotently",
    "isort",
    "jsii",
    "kwargs",
    "levelname",
    "lifecycles",
    "Mangum",
    "monkeypatch",
    "moto",
    "mypy",
    "namespacing",
    "noqa",
    "parameterizing",
    "pathlib",
    "perflint",
    "pids",
    "PITR",
    "precheck",
    "preconfigured",
    "pycodestyle",
    "pydantic",
    "pydocstyle",
    "pyflakes",
    "Pylance",
    "pylint",
    "pypdf",
    "pyproject",
    "pyright",
    "pytest",
    "pythonpath",
    "pyupgrade",
    "pyyaml",
    "pycache",
    "rahul",
    "refurb",
    "runbook",
    "selectbox",
    "starlette",
    "stepfunctions",
    "strawmen",
    "streamlit",
    "tamasfe",
    "testpaths",
    "tryceratops",
    "título",
    "unbuilt",
    "unconfigured",
    "unparameterized",
    "uvicorn",
    "venv",
    "webbrowser",
    "xfail"
  ],
  "languageSettings": [
    {
      "languageId": "markdown",
      "ignoreRegExpList": ["MermaidBlock"]
    }
  ],
  "patterns": [
    {
      "name": "MermaidBlock",
      "pattern": "/^```mermaid[\\s\\S]*?^```/gmu"
    }
  ]
}
